{
  "name": "quantum-signer",
  "version": "2.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Native OpenSSL-backed post-quantum signing and browser verification",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/dev.mjs --preview",
    "build": "node scripts/build.mjs",
    "check:repro": "node scripts/repro-check.mjs",
    "test:headers": "node scripts/security-headers-test.mjs",
    "test:live-headers": "node scripts/live-security-headers-test.mjs",
    "test:local-headers": "node scripts/local-security-headers-test.mjs",
    "test:external-vectors": "node scripts/external-vectors-test.mjs",
    "test:p0-security": "node scripts/p0-security-test.mjs",
    "test:session": "node scripts/secret-session-test.mjs",
    "test:worker": "node scripts/worker-client-test.mjs",
    "test:build-config": "node scripts/build-config-test.mjs",
    "test:mutation-corpus": "node scripts/container-mutation-test.mjs",
    "selftest": "npm run test:headers && npm run test:build-config && npm run test:p0-security && npm run test:session && npm run test:worker && npm run test:mutation-corpus && npm run test:browser-boundary && node scripts/selftest.mjs",
    "check": "npm run selftest && npm run test:native && npm run test:local-headers && npm run build",
    "test:native": "node scripts/native-key-validation-test.mjs && node scripts/native-crypto-test.mjs",
    "signer": "node src/native/cli.mjs",
    "test:browser-boundary": "node scripts/browser-boundary-test.mjs",
    "package:release": "node scripts/package-release.mjs",
    "test:release": "node scripts/release-test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#crypto/hashes": {
      "node": "./src/crypto/native-hashes.js",
      "default": "@noble/hashes/sha3.js"
    },
    "#crypto/verification": {
      "node": "./src/native/crypto.js",
      "default": "./src/crypto/browser-verification.js"
    }
  }
}
